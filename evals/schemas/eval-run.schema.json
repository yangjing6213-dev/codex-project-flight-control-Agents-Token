{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "BuilderEfficiency evaluation output contract revision 2; strict structured outputs.",
  "type": "object",
  "required": ["scenario_id", "phase", "status", "metrics"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^EFF-0[1-7]$"},
    "phase": {"enum": ["RED", "GREEN"]},
    "status": {"enum": ["PASS", "FAIL", "PARTIAL", "NOT_RUN"]},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {"type": "string"},
          "value": {"type": ["string", "number", "boolean", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
