{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "pfc.wave-plan.v1"
      ]
    },
    "wave_id": {
      "type": "string",
      "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
    },
    "base_checkpoint_sha": {
      "type": "string",
      "pattern": "(?-i:^[0-9a-f]{40}\\z)"
    },
    "goal_id": {
      "type": "string",
      "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
    },
    "stop_gate": {
      "type": "string",
      "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "milestone_id": {
            "type": "string",
            "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
          },
          "contract_id": {
            "type": "string",
            "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
          },
          "contract_version": {
            "type": "integer"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
            }
          },
          "exact_branch": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:\\.\\.|//|@\\{|[~^:?*\\[\\\\\\s]))(?!.*(?:\\.\\z|/\\z|\\.lock\\z))[^/]+(?:/[^/]+)*\\z"
          },
          "worktree_identity_algorithm": {
            "type": "string",
            "enum": [
              "PFC_WORKTREE_ROOT_SHA256_V1"
            ]
          },
          "worktree_identity": {
            "type": "string",
            "pattern": "(?-i:^[0-9a-f]{64}\\z)"
          },
          "validation_plan": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "enum": [
                    "T1",
                    "T2",
                    "T3",
                    "T4",
                    "ROLLBACK",
                    "UPGRADE_DOWNGRADE",
                    "FAULT_INJECTION",
                    "USER_GATE"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "applicability_reason": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "FAIL",
                    "PARTIAL",
                    "NOT_RUN"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
                      },
                      "candidate_sha": {
                        "type": "string",
                        "pattern": "(?-i:^[0-9a-f]{40}\\z)"
                      },
                      "reference": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "evidence_id",
                      "candidate_sha",
                      "reference"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "tier",
                "required",
                "applicability_reason",
                "checks",
                "result",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "milestone_id",
          "contract_id",
          "contract_version",
          "risk_level",
          "dependencies",
          "exact_branch",
          "worktree_identity_algorithm",
          "worktree_identity",
          "validation_plan"
        ],
        "additionalProperties": false
      }
    },
    "wave_validation": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "T1",
            "T2",
            "T3",
            "T4",
            "ROLLBACK",
            "UPGRADE_DOWNGRADE",
            "FAULT_INJECTION",
            "USER_GATE"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "applicability_reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "PARTIAL",
            "NOT_RUN"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "(?-i:^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\\z)"
              },
              "candidate_sha": {
                "type": "string",
                "pattern": "(?-i:^[0-9a-f]{40}\\z)"
              },
              "reference": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "evidence_id",
              "candidate_sha",
              "reference"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tier",
        "required",
        "applicability_reason",
        "checks",
        "result",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "authorization_id",
    "base_checkpoint_sha",
    "goal_id",
    "stop_gate",
    "milestones",
    "wave_validation"
  ],
  "additionalProperties": false
}
