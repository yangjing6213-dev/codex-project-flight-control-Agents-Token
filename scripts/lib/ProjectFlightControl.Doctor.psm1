Set-StrictMode -Version 2.0
Import-Module (Join-Path $PSScriptRoot 'ProjectFlightControl.Core.psm1') -Force

function Get-PfcDoctorFileHash { param([string]$Path)
    if (-not $Path -or -not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $null }
    try { return Get-PfcSha256 $Path } catch { return $null }
}
function Get-PfcSkillMajor { param([string[]]$Paths)
    foreach ($path in @($Paths)) { if (-not $path -or -not (Test-Path -LiteralPath $path -PathType Leaf)) { continue }; try { $text=Get-Content -Raw -LiteralPath $path -ErrorAction Stop; if($text -match '(?im)^\s*(?:skill_major|skill_major_version|major_version)\s*:\s*([0-9]+)\s*$'){return $Matches[1]} } catch { continue } }; return 'UNKNOWN'
}
function Get-PfcSandboxPermission { param([string]$Path)
    $unknown = [pscustomobject]@{ status='UNKNOWN'; mode='UNKNOWN'; reason='permission-unobservable' }
    if (-not $Path -or -not (Test-Path -LiteralPath $Path -PathType Leaf)) { $unknown.reason='permission-config-missing'; return $unknown }
    try { $text=Get-Content -Raw -LiteralPath $Path -ErrorAction Stop } catch { $unknown.reason='permission-config-unreadable'; return $unknown }
    if ([string]::IsNullOrWhiteSpace($text)) { $unknown.reason='permission-config-malformed'; return $unknown }
    $match=[regex]::Match($text,'(?im)^\s*(sandbox_mode|permission_mode|sandbox_permission)\s*=\s*["'']([^"'']+)["'']\s*$')
    if (-not $match.Success) { $unknown.reason='permission-config-unparseable'; return $unknown }
    $mode=$match.Groups[2].Value.Trim().ToLowerInvariant()
    if ($mode -eq 'read-only') { return [pscustomobject]@{status='PASS';mode=$mode;reason='explicit-read-only-semantic'} }
    if ($mode -in @('workspace-write','danger-full-access')) { $unknown.reason='permission-mode-writable'; $unknown.mode=$mode; return $unknown }
    $unknown.reason='permission-mode-unsupported'; $unknown.mode=$mode; return $unknown
}
function Invoke-PfcDoctorProcess { param([string]$Command,[string[]]$Arguments,[scriptblock]$ProcessInvoker)
    $argv=@($Command)+@($Arguments); if($ProcessInvoker){try{$result=& $ProcessInvoker $argv;if($result -and $result.PSObject.Properties['ExitCode']){return $result};return [pscustomobject]@{ExitCode=0;StdOut=(($result|Out-String).Trim());StdErr=''}}catch{return [pscustomobject]@{ExitCode=1;StdOut='';StdErr=$_.Exception.Message}}}; try{$stdout=& $Command @Arguments 2>&1;$code=$LASTEXITCODE;return [pscustomobject]@{ExitCode=$code;StdOut=(($stdout|Out-String).Trim());StdErr=''}}catch{return [pscustomobject]@{ExitCode=1;StdOut='';StdErr=$_.Exception.Message}}
}
function Invoke-PfcDoctorGit { param([string[]]$Arguments,[scriptblock]$ProcessInvoker) return Invoke-PfcDoctorProcess -Command 'git' -Arguments $Arguments -ProcessInvoker $ProcessInvoker }
