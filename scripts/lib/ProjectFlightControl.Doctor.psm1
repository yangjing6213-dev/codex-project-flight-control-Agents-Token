function Invoke-PfcSpecialistSmoke {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory=$true)][switch]$SpecialistSmoke,
        [Parameter(Mandatory=$true)][string]$RepositoryRoot,
        [Parameter(Mandatory=$true)][string]$UserHome,
        [Parameter(Mandatory=$true)][string]$StateRoot,
        [scriptblock]$ProcessInvoker=$null,
        [scriptblock]$WorktreeAdapter=$null,
        [scriptblock]$SpecialistInvoker=$null,
        [AllowNull()][string]$ExpectedSha,
        [AllowNull()][object]$PriorRecord
    )
    $unknown = {
        param([string]$Reason,[string]$Status='UNKNOWN')
        [pscustomobject]@{ status=$Status; specialist_capability=$Status; verification_source='SMOKE_TEST'; verified_at=[DateTime]::UtcNow.ToString('o'); client_version='UNKNOWN'; skill_major='UNKNOWN'; isolation='UNKNOWN'; sha='UNKNOWN'; report='UNKNOWN'; cleanup='UNKNOWN'; invalidation_reason=$Reason; evidence=@() }
    }
    if (-not $SpecialistSmoke) { throw 'SpecialistSmoke switch is required.' }
    # A real invocation is deliberately opt-in.  In particular, do not turn a
    # plain single-agent client invocation into evidence of subagent capability.
    if ($null -eq $ProcessInvoker -or $null -eq $WorktreeAdapter -or $null -eq $SpecialistInvoker) {
        return (& $unknown 'runtime-capability-unconfirmed')
    }
    $evidence = New-Object System.Collections.Generic.List[object]
    $root = Join-Path ([IO.Path]::GetTempPath()) ('pfc-specialist-smoke-' + [guid]::NewGuid().ToString('N'))
    $fixture = Join-Path $root 'repo'; $worktree = Join-Path $root 'worktree'; $removed = $false
    $status = 'UNKNOWN'; $reason = 'smoke-invariant-unproven'; $sha = $ExpectedSha; $reportHash = $null
    try {
        New-Item -ItemType Directory -Path $root -Force -ErrorAction Stop | Out-Null
        $fixtureResult = & $WorktreeAdapter 'create-fixture' ([pscustomobject]@{ root=$fixture; repository=$RepositoryRoot })
        if (-not $fixtureResult -or -not (Test-Path -LiteralPath $fixture -PathType Container)) { throw 'fixture-repository-unavailable' }
        [void]$evidence.Add([pscustomobject]@{ step='fixture'; status='PASS' })
        $git = {
            param([string[]]$Arguments)
            $r = & $ProcessInvoker (@('git') + @($Arguments))
            if (-not $r -or -not $r.PSObject.Properties['ExitCode']) { throw 'process-adapter-invalid-result' }
            return $r
        }
        $r = & $git @('-C',$fixture,'rev-parse','HEAD'); $candidateSha = ([string]$r.StdOut).Trim()
        if ([int]$r.ExitCode -ne 0 -or $candidateSha -notmatch '^[0-9a-fA-F]{40}$') { throw 'fixed-sha-unavailable' }
        if ($sha -and $sha -cne $candidateSha) { throw 'fixed-sha-mismatch' }; $sha = $candidateSha
        $r = & $git @('-C',$fixture,'status','--porcelain'); if ([int]$r.ExitCode -ne 0 -or -not [string]::IsNullOrWhiteSpace([string]$r.StdOut)) { throw 'fixture-not-clean' }
        [void]$evidence.Add([pscustomobject]@{ step='fixture-sha'; status='PASS'; sha=$sha })
        $wt = & $WorktreeAdapter 'create-worktree' ([pscustomobject]@{ repository=$fixture; path=$worktree; sha=$sha; read_only=$true })
        if (-not $wt -or -not (Test-Path -LiteralPath $worktree -PathType Container)) { throw 'independent-worktree-unavailable' }
        if (-not $wt.PSObject.Properties['detached'] -or -not [bool]$wt.detached) { throw 'worktree-detached-proof-missing' }
        $r = & $git @('-C',$worktree,'symbolic-ref','--short','-q','HEAD')
        if ([int]$r.ExitCode -ne 1 -or -not [string]::IsNullOrWhiteSpace([string]$r.StdOut)) { throw 'worktree-not-detached' }
        [void]$evidence.Add([pscustomobject]@{ step='worktree'; status='PASS' })
        $beforeTracked = & $git @('-C',$fixture,'status','--porcelain'); if ([int]$beforeTracked.ExitCode -ne 0) { throw 'tracked-check-before-failed' }
        $order = [pscustomobject]@{ request='SPECIALIST_ORDER'; read_only=$true; repository=$worktree; evidence_sha=$sha; output_schema='SPECIALIST_REPORT'; forbidden=@('write-tracked-files','stage-files','network') }
        $smoke = & $SpecialistInvoker $order
        if (-not $smoke -or -not $smoke.report) { throw 'structured-report-missing' }
        $report = $smoke.report
        $requiredReport = $null; $allowedReport = $null
        switch ([string]$report.status) {
            'FINDING' {
                $requiredReport = @('control_run_id','lease_epoch','goal_id','goal_version','milestone_id','milestone_contract_version','revision','sender_role','recipient_role','created_at','status','specialist_report_id','specialist_order_id','question','evidence_sha','finding','evidence','risk','recommendation','confidence','diagnostics_run')
                $allowedReport = $requiredReport
            }
            'EVIDENCE_NEEDED' {
                $requiredReport = @('control_run_id','lease_epoch','goal_id','goal_version','milestone_id','milestone_contract_version','revision','sender_role','recipient_role','created_at','status','specialist_report_id','specialist_order_id','evidence_sha','missing_evidence','why_required','requested_scope','requested_diagnostic','risk')
                $allowedReport = $requiredReport
            }
            'UNRESOLVED' {
                $requiredReport = @('control_run_id','lease_epoch','goal_id','goal_version','milestone_id','milestone_contract_version','revision','sender_role','recipient_role','created_at','status','specialist_report_id','specialist_order_id','evidence_sha','known','unknown','evidence_reviewed','why_unresolved','decision_risk','recommended_next_action')
                $allowedReport = $requiredReport
            }
            default { throw 'structured-report-status-invalid' }
        }
        foreach ($field in $requiredReport) { if (-not $report.PSObject.Properties[$field] -or [string]::IsNullOrWhiteSpace([string]$report.$field)) { throw ('structured-report-'+$field+'-missing') } }
        if ([string]$report.sender_role -cne 'Specialist' -or [string]$report.recipient_role -cne 'Goalkeeper') { throw 'structured-report-roles-invalid' }
        if ([string]$report.evidence_sha -notmatch '^[0-9a-f]{40}$') { throw 'structured-report-evidence-sha-invalid' }
        if (@($report.PSObject.Properties.Name | Where-Object { $_ -notin $allowedReport }).Count -gt 0) { throw 'structured-report-additional-property' }
        if ([string]$report.evidence_sha -cne [string]$sha) { throw 'structured-report-evidence-sha-mismatch' }
        if ($report.PSObject.Properties['verdict'] -or $report.PSObject.Properties['decision']) { throw 'structured-report-formal-verdict-forbidden' }
        $reportText = $smoke.report | ConvertTo-Json -Depth 20 -Compress
        $reportHash = [BitConverter]::ToString(([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($reportText)))).Replace('-','').ToLowerInvariant()
        if (-not $smoke.PSObject.Properties['report_sha256'] -or [string]::IsNullOrWhiteSpace([string]$smoke.report_sha256)) { throw 'structured-report-sha-missing' }
        if ([string]$smoke.report_sha256 -cne $reportHash) { throw 'structured-report-sha-mismatch' }
        if (-not $smoke.PSObject.Properties['read_only'] -or -not [bool]$smoke.read_only) { throw 'read-only-proof-missing' }
        [void]$evidence.Add([pscustomobject]@{ step='order-report'; status='PASS'; report_sha256=$reportHash })
        $afterTracked = & $git @('-C',$fixture,'status','--porcelain'); if ([int]$afterTracked.ExitCode -ne 0 -or ([string]$afterTracked.StdOut).Trim() -cne ([string]$beforeTracked.StdOut).Trim()) { throw 'tracked-changes-detected' }
        $staged = & $git @('-C',$worktree,'diff','--cached','--name-only'); if ([int]$staged.ExitCode -ne 0 -or -not [string]::IsNullOrWhiteSpace([string]$staged.StdOut)) { throw 'staged-changes-detected' }
        [void]$evidence.Add([pscustomobject]@{ step='tracked-staged-after'; status='PASS' })
        $closed = & $SpecialistInvoker ([pscustomobject]@{ action='close'; repository=$worktree })
        if (-not $closed -or -not $closed.PSObject.Properties['status'] -or [string]$closed.status -ne 'PASS') { throw 'specialist-process-close-unconfirmed' }
        $removedResult = & $WorktreeAdapter 'remove-worktree' ([pscustomobject]@{ repository=$fixture; path=$worktree; standard_remove=$true })
        if (-not $removedResult -or -not $removedResult.PSObject.Properties['status'] -or [string]$removedResult.status -ne 'PASS') { throw 'worktree-remove-unconfirmed' }
        if (-not $removedResult.PSObject.Properties['standard_remove'] -or -not [bool]$removedResult.standard_remove) { throw 'standard-worktree-remove-proof-missing' }
        if (Test-Path -LiteralPath $worktree) { throw 'worktree-cleanup-failed' }; $removed = $true
        [void]$evidence.Add([pscustomobject]@{ step='close-cleanup'; status='PASS' })
        $status='AVAILABLE'; $reason='all smoke invariants proven'
    } catch { $status='UNKNOWN'; $reason=$_.Exception.Message }
    finally {
        if (Test-Path -LiteralPath $root) { try { Remove-Item -LiteralPath $root -Recurse -Force -ErrorAction Stop } catch { if ($status -eq 'AVAILABLE') { $status='UNKNOWN'; $reason='smoke-fixture-cleanup-failed' } } }
    }
    [pscustomobject]@{ status=$status; specialist_capability=$status; verification_source='SMOKE_TEST'; verified_at=[DateTime]::UtcNow.ToString('o'); client_version='UNKNOWN'; skill_major='UNKNOWN'; isolation=$(if($status -eq 'AVAILABLE'){'PASS'}else{'UNKNOWN'}); sha=$(if($status -eq 'AVAILABLE'){'VALID'}else{'UNKNOWN'}); report=$(if($status -eq 'AVAILABLE'){'PASS'}else{'UNKNOWN'}); cleanup=$(if($removed){'PASS'}else{'UNKNOWN'}); invalidation_reason=$(if($status -eq 'AVAILABLE'){$null}else{$reason}); prior_record_invalidated=$(if($status -eq 'AVAILABLE'){$false}else{($null -ne $PriorRecord -and [string]$PriorRecord.status -eq 'AVAILABLE')}); evidence=$evidence.ToArray(); report_sha256=$reportHash }
}
Export-ModuleMember -Function Invoke-PfcPassiveDoctor,Get-PfcDoctorFingerprint,Get-PfcSpecialistCapabilityState,Invoke-PfcSpecialistSmoke
